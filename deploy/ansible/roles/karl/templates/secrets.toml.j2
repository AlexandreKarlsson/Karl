# vault_karl_* → one table per secret name referenced by /etc/karl/karl.toml
[atl-{{ karl_profile }}]
email = "{{ vault_karl_atl_email }}"
token = "{{ vault_karl_atl_token }}"

[google-{{ karl_profile }}]
client_id     = "{{ vault_karl_google_client_id }}"
client_secret = "{{ vault_karl_google_client_secret }}"
refresh_token = "{{ vault_karl_google_refresh_token }}"
